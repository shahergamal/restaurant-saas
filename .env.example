# ---- API (apps/api) ----
# Owner role: migrations, seed, and the narrow pre-tenant auth lookups. Never used for tenant requests.
DATABASE_URL="postgresql://sufra_owner:sufra_owner_dev@localhost:5432/sufra?schema=public"
# Runtime role: every tenant request runs as this role, with Row-Level Security enforced.
DATABASE_URL_APP="postgresql://sufra_app:sufra_app_dev@localhost:5432/sufra?schema=public"
REDIS_URL="redis://localhost:6379"
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
API_PORT=4000
# Comma-separated list of origins allowed to call the API (CORS + CSRF origin check)
WEB_ORIGINS="http://localhost:3000"
COOKIE_SECURE=false
TZ_DEFAULT="Asia/Riyadh"

# ---- Web (apps/web) ----
API_INTERNAL_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
# 32 random bytes, base64. Encrypts MFA secrets and customer personal data at rest. openssl rand -base64 32
DATA_ENCRYPTION_KEY=""
# true = owners and managers must enroll in MFA before using the app
MFA_ENFORCE=false
